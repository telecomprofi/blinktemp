<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Average -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/average_label" />

        <TextView
            android:id="@+id/avg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/minmax_24h"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_sign"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sign_in" />

            <Button
                android:id="@+id/btn_refresh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/refresh" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/unit_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/use_celsius" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/skip_offline_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/skip_offline" />

        <!-- History -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/history_header" />

        <RadioGroup
            android:id="@+id/range_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/range_day"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/range_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/range_day" />

            <RadioButton
                android:id="@+id/range_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/range_week" />
        </RadioGroup>

        <com.example.blinktemp.TempChartView
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/chart_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/history_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/history_switch" />

        <Button
            android:id="@+id/btn_clear_history"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_clear" />

        <!-- Regular temperature refresh -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/temp_header" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="@string/temp_hint" />

        <Spinner
            android:id="@+id/temp_interval_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/temp_photo_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/temp_photo" />

        <Button
            android:id="@+id/btn_temp_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/temp_now" />

        <TextView
            android:id="@+id/last_temp_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7" />

        <!-- Cameras -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/cameras_header" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="@string/cameras_hint" />

        <LinearLayout
            android:id="@+id/camera_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Scheduled image refresh -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/snap_header" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="@string/snap_hint" />

        <Spinner
            android:id="@+id/interval_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/window_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/only_between" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_from"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:text="–" />

            <Button
                android:id="@+id/btn_to"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_snap_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/snap_now" />

        <TextView
            android:id="@+id/last_snap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7" />

        <!-- Freeze alert -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/alert_header" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/alert_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/alert_switch" />

        <Spinner
            android:id="@+id/alert_threshold_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="@string/alert_hint" />

        <Button
            android:id="@+id/btn_alert_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/alert_test" />
    </LinearLayout>
</ScrollView>
